# systemd *user* unit: starts the deck fullscreen with the desktop session and restarts it if it exits.
# Installed by scripts/install-autostart.sh; logs: journalctl --user -u pi-deck
[Unit]
Description=Pi Media Deck UI
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/pi-deck
ExecStart=%h/pi-deck/.venv/bin/python -m deck
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
